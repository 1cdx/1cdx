<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_tab_inactive"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/quick_input"
        style="@style/Onecdx.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/quick_open_hint"
        android:imeOptions="actionGo|flagNoExtractUi"
        android:inputType="text" />

    <TextView
        android:id="@+id/quick_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/quick_open_empty"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/quick_list"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="6dp"
        android:choiceMode="singleChoice"
        android:divider="@null"
        android:listSelector="@drawable/bg_row" />
</LinearLayout>
