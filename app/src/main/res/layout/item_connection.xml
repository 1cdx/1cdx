<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_server" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/connection_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_bright"
            android:textSize="14sp"
            tools:text="VPS produksi" />

        <TextView
            android:id="@+id/connection_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="deploy@10.0.0.2:/var/www/app" />
    </LinearLayout>

    <TextView
        android:id="@+id/connection_menu"
        style="@style/Onecdx.TextButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/more_actions"
        android:gravity="center"
        android:text="⋯"
        android:textSize="16sp" />
</LinearLayout>
