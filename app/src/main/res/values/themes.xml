<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Onecdx" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_sidebar</item>
        <item name="android:colorBackground">@color/bg_editor</item>
        <item name="android:colorPrimary">@color/bg_sidebar</item>
        <item name="android:colorPrimaryDark">@color/bg_sidebar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor">@color/bg_sidebar</item>
        <item name="android:navigationBarColor">@color/bg_sidebar</item>
        <item name="android:alertDialogTheme">@style/Theme.Onecdx.Dialog</item>
    </style>

    <style name="Theme.Onecdx.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/bg_tab_inactive</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Onecdx.TextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_row</item>
    </style>

    <style name="Onecdx.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Onecdx.StatusItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/text_bright</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
